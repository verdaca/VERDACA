# Praxis — Clean repo scope
# Only kernel/, shell/, and docs/ are tracked.
# Everything else (BMAD framework, planning workspace, research, Claude config) is excluded.

# ============================================================
# Step 1: Exclude everything at root by default
# ============================================================
/*

# Step 2: Re-include the Praxis project directories
!.gitignore
!README.md
!kernel/
!ports/
!adapters/
!tests/
!shell/
!docs/
!knowledge/
!assets/
!pyproject.toml
!.python-version
!uv.lock

# ============================================================
# Workspace files — NEVER tracked
# ============================================================
# These exist in the working directory but are not part of Praxis.
# Listed explicitly for safety even though /* already covers them.
_bmad/
_bmad-output/
.claude/
Articles/
/Memory/
CLAUDE.md
claude-setup-reference.md
knowledge/raw/

# ============================================================
# Python development cruft
# ============================================================
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.hypothesis/
**/.coverage
**/.coverage.*
**/htmlcov/
**/.tox/
**/dist/
**/build/
**/*.egg-info/
**/.venv/
**/venv/
**/env/
**/graphify-out/

# ============================================================
# Node.js / Next.js cruft
# ============================================================
**/node_modules/
**/.next/
**/out/
**/.turbo/

# ============================================================
# Editor / OS cruft
# ============================================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================================
# Secrets (defensive — none expected but safety net)
# ============================================================
.env
.env.*
.env.local
*.key
*.pem
credentials.json
secrets.yaml
